# Allthing needs no configuration: by default it reads the free, no-auth
# Hypersnap API. Copy to .env.local only if you want to change the source.
# Never commit a real .env file.

# Which Neynar-shaped API to read: hypersnap (default) or neynar
ALLTHING_DATA_SOURCE=hypersnap

# Optional: another base URL that speaks the same API, e.g. a self-hosted Hypersnap
# ALLTHING_API_BASE_URL=https://haatz.quilibrium.com/v2/farcaster

# Required only when ALLTHING_DATA_SOURCE=neynar
# NEYNAR_API_KEY=
