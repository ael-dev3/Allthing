{
  "name": "allthing",
  "version": "0.1.0",
  "private": true,
  "description": "A read-only, old-reddit-style Farcaster client.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
