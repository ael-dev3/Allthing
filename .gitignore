# Rust and build output
/target/
/dist/
/dist-pages/
/crates/allthing-worker/build/
**/*.rs.bk

# Node tooling (wrangler, Playwright); wrangler also leaves .wrangler/ in e2e/
node_modules/
.wrangler/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Screenshots saved by the live end-to-end suite (e2e/allthing.spec.ts). Only
# the one the README shows is tracked; add a `!` line to track another.
/docs/screenshots/*
!/docs/screenshots/*.webp

# Never commit secrets or local settings
.env
.env.*
.dev.vars*
*.pem
*.key

# Editors, operating systems and logs
.DS_Store
Thumbs.db
*.log
*.swp
*~
.idea/
.vscode/
