# Headers for static assets (Workers Static Assets). The Worker shell reuses
# this global security block; document responses add no-store separately.
# API responses set their own headers.
# connect-src allows any https origin because HLS playlists and segments are
# fetched straight from wherever a cast's video is hosted, never proxied.
# wss://maincloud.spacetimedb.com is Allthing's SpacetimeDB database, which
# the Messages inbox on /messages connects to (docs/ARCHITECTURE.md#messages-on-spacetimedb).

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'inline-speculation-rules' https://static.cloudflareinsights.com 'sha256-7MR8usYANrh7vyUz5TYodWF71FASRetYK9s8dhW7ohY=' 'sha256-sRrwKjqHT1qGbGjlpIO5jxMbyYntwB4HLAzVyr2HXFA=' 'sha256-OCdcCySGf2C2Sgd561xC2Uhc6d8FplAkPrG7w63LhsE='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' https: wss://maincloud.spacetimedb.com; frame-src https://www.youtube-nocookie.com https://player.vimeo.com https://www.loom.com https://streamable.com; font-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The logo as a PNG, for the picture of Allthing's Farcaster account,
# @allthingapp (apps show an SVG picture as blank). It is cached for a year,
# so a new logo gets a new file name rather than replacing this one.
/pfp.png
  Cache-Control: public, max-age=31536000, immutable
